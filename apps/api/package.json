    "zod": "^4.1.12",
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.7.0",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.20.5",
