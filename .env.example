# ---------------------------------------------------------------------------
# CollabSpace AI Team - environment configuration
# Copy to .env and adjust. Never commit a real .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- Database / cache -------------------------------------------------------
DATABASE_URL=postgresql://csai:csai@localhost:5440/csai?schema=public
REDIS_URL=redis://localhost:6390

# --- HTTP -------------------------------------------------------------------
API_PORT=4120
API_PUBLIC_URL=http://localhost:4120
WEB_ORIGIN=http://localhost:5190
# 32+ random characters. Used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string
# 32 bytes, base64 encoded. Used to encrypt integration credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=
# Set to true in production behind HTTPS.
COOKIE_SECURE=false

# --- Object storage (S3 compatible) ------------------------------------------
# STORAGE_DRIVER=s3 uses the S3 settings below (MinIO from docker-compose works out of the box).
# STORAGE_DRIVER=local writes files to STORAGE_LOCAL_DIR (development only).
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9400
S3_REGION=us-east-1
S3_BUCKET=csai-artifacts
S3_ACCESS_KEY_ID=csai-minio
S3_SECRET_ACCESS_KEY=csai-minio-secret
S3_FORCE_PATH_STYLE=true
STORAGE_LOCAL_DIR=.storage

# --- AI provider -------------------------------------------------------------
# AI_PROVIDER: anthropic | openai | mock | (empty = not configured)
#   anthropic : requires ANTHROPIC_API_KEY
#   openai    : requires OPENAI_API_KEY (OPENAI_BASE_URL optional for compatible gateways)
#   mock      : deterministic provider with no network access. Development/testing only.
#               The UI labels mock executions clearly. Never use in production.
AI_PROVIDER=
AI_DEFAULT_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Optional embeddings for knowledge retrieval. Leave empty to use Postgres full-text search only.
EMBEDDINGS_PROVIDER=
EMBEDDINGS_MODEL=

# --- Worker -----------------------------------------------------------------
WORKER_CONCURRENCY=4
WORKSPACE_MAX_CONCURRENT_TASKS=5
TASK_DEFAULT_TIMEOUT_MS=600000
TASK_HEARTBEAT_MS=15000
TASK_STALE_AFTER_MS=90000
TASK_MAX_RETRIES=2

# --- Email (optional; verification and recovery are skipped when unset) -----
SMTP_URL=
MAIL_FROM=no-reply@collabspace.local

# --- Integrations (optional) ---------------------------------------------------
# GitHub integration is configured per workspace in the UI (token stored encrypted).
# Outbound webhooks for message.send are configured per workspace in the UI.
